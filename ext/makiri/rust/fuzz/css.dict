# Selector tokens for the HTML CSS targets (html_css, html_css_diff): the
# input is `selector NUL document`, and byte-level mutation alone rarely keeps
# a selector parseable long enough to reach the matcher's deep paths.
sep="\x00"
c_desc=" "
c_child=" > "
c_next=" + "
c_sub=" ~ "
c_col=" || "
comma=", "
star="*"
id="#a"
cls=".a"
cls2=".b"
t_div="div"
t_p="p"
t_li="li"
t_ul="ul"
t_a="a"
t_span="span"
t_input="input"
t_svg="svg"
t_ns="svg|circle"
a_has="[a]"
a_eq="[a=x]"
a_inc="[a~=x]"
a_dash="[a|=x]"
a_pre="[a^=x]"
a_suf="[a$=x]"
a_sub="[a*=x]"
a_i=" i]"
a_s=" s]"
p_first=":first-child"
p_last=":last-child"
p_only=":only-child"
p_fot=":first-of-type"
p_lot=":last-of-type"
p_oot=":only-of-type"
p_empty=":empty"
p_root=":root"
p_link=":link"
p_anylink=":any-link"
p_req=":required"
p_opt=":optional"
p_ro=":read-only"
p_rw=":read-write"
p_ph=":placeholder-shown"
p_hover=":hover"
p_focus=":focus"
p_checked=":checked"
p_disabled=":disabled"
p_enabled=":enabled"
f_is=":is("
f_where=":where("
f_not=":not("
f_has=":has("
f_has_child=":has(> "
f_has_next=":has(+ "
f_has_sub=":has(~ "
f_nth=":nth-child("
f_nthl=":nth-last-child("
f_nthot=":nth-of-type("
f_nthlot=":nth-last-of-type("
anb_odd="odd"
anb_even="even"
anb_1="2n+1"
anb_2="-n+3"
anb_of=" of "
close=")"
h_div="<div class=a id=a>"
h_p="<p a=x>"
h_li="<ul><li>"
h_a="<a href=x>"
h_input="<input required placeholder=x>"
h_svg="<svg><circle r=1></svg>"
h_close="</div>"
h_quirks="<!doctype html>"
