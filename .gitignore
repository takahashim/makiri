# Bundler
Gemfile.lock

# Fuzzer findings (keep the directory, not the per-run output)
spec/fuzz/regressions/*
!spec/fuzz/regressions/.gitkeep

# Conformance test data (fetched on demand & pinned by the runner; not vendored)
spec/conformance/data/

# Rust build output
ext/makiri/rust/target/

# cargo-fuzz: build output, the accumulated corpus (kept in CI cache, not here)
# and any crash reproducers it saves.
ext/makiri/rust/fuzz/target/
ext/makiri/rust/fuzz/corpus/
ext/makiri/rust/fuzz/artifacts/

# Scratch measurement harnesses under the crate (not shipped).
ext/makiri/rust/examples/
